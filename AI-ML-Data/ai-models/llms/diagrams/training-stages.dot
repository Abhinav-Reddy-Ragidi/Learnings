// 2x2 serpentine so the long stage descriptions stay readable at page width.
digraph stages {
  rankdir=LR;
  graph [fontname="Helvetica", ranksep=0.5, nodesep=0.35];
  node  [shape=box, style="rounded,filled", fillcolor="#EEF2F7",
         color="#3B5470", fontname="Helvetica", fontsize=10, margin="0.16,0.10"];
  edge  [color="#5A7391", arrowsize=0.7, fontname="Helvetica", fontsize=9];

  p [label="1. PRETRAINING\nPredict the next token on web-scale text\n\nGains: language, facts, latent reasoning\nCost: months of compute", fillcolor="#D8E4F0"];
  s [label="2. SUPERVISED FINE-TUNING\nImitate curated (instruction, answer) pairs\n\nGains: follows instructions,\nanswers instead of continuing"];

  r [label="3. PREFERENCE TUNING (RLHF / DPO)\nLearn from \"A is better than B\"\n\nGains: helpful, honest, safe;\ntone and format calibration", fillcolor="#EBCEA6", color="#A9762F"];
  d [label="4. DEPLOYMENT-TIME SHAPING\nSystem prompt · retrieval · tools ·\nreasoning effort · decoding params\n\nThe only stage YOU control", fillcolor="#F3DFC8", color="#A9762F"];

  p -> s;
  s -> r [constraint=false];
  r -> d;

  n1 [label="A base model continues text.\nA chat model answers you.\nThat difference is stages 2 and 3.",
      shape=note, fillcolor="#FAFAFA", fontsize=9];
  d -> n1 [style=dotted, arrowhead=none, constraint=false];
}
