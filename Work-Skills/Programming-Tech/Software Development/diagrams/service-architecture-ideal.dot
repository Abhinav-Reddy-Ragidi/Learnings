// Target architecture: apps/api as the sole Core Domain Service / System of Record.
// Every internal call is IAM-authenticated (OIDC), not a static shared secret.
digraph ServiceArchIdeal {
  rankdir=LR;
  bgcolor="transparent";
  nodesep=0.30;
  ranksep=0.75;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
        color="#334155", fillcolor="#f8fafc", penwidth=1.2, margin="0.14,0.09"];
  edge [color="#94a3b8", penwidth=1.0, arrowsize=0.6, fontname="Helvetica", fontsize=8.5, fontcolor="#64748b"];
  graph [fontname="Helvetica", fontsize=10.5, labeljust="l", labelloc="b",
         style="rounded,filled", color="#cbd5e1"];

  label="Internal edges use Cloud Run IAM invoker + short-lived OIDC ID tokens\n(verified at the platform layer) instead of app-level shared secrets.";

  subgraph cluster_client {
    label="Browser";
    fillcolor="#eff6ff";
    dash [label="Dashboard\n(Next.js)", fillcolor="#dbeafe"];
  }

  subgraph cluster_services {
    label="Cloud Run — private (--no-allow-unauthenticated) except apps/api";
    fillcolor="#fefce8";
    api  [label="apps/api\nCORE DOMAIN SERVICE\nsole DB writer · authN/authZ", fillcolor="#fde68a", penwidth=1.8];
    guide[label="guide-agent\nFastAPI + LangChain\nno DB creds", fillcolor="#fef9c3"];
    msr  [label="manuscript-reviewer\nCloud Run JOB\nno DB creds", fillcolor="#fef9c3"];
    intv [label="interview-service\nFastAPI + WebSocket\nDB creds REMOVED", fillcolor="#fef9c3"];
  }

  subgraph cluster_policy {
    label="Optional / advanced";
    style="rounded,dashed";
    color="#a855f7";
    fillcolor="#faf5ff";
    opa [label="Externalized policy service\n(e.g. OPA / Zanzibar-style)\n\"can user X do Y?\"", fillcolor="#f3e8ff"];
  }

  subgraph cluster_data {
    label="Managed state";
    fillcolor="#f0fdf4";
    ckdb [label="CockroachDB", fillcolor="#dcfce7"];
  }

  dash -> api  [label="REST/WS (Firebase JWT)"];
  dash -> intv [label="WebSocket — sanctioned exception\n(real-time audio latency)", style=dashed];

  api  -> guide [label="OIDC ID token\n+ enqueue Cloud Task"];
  guide -> api  [label="generated Python client\n(from OpenAPI spec) + OIDC"];

  api  -> msr  [label="Cloud Run Jobs Admin API"];
  msr  -> api  [label="OIDC-authenticated callback"];

  intv -> api  [label="generated Python client + OIDC\n(replaces direct DB access)", color="#16a34a", fontcolor="#15803d"];

  api  -> ckdb [label="Prisma — ONLY writer"];

  api -> opa [label="authz decision", style=dashed, color="#a855f7"];
  guide -> opa [label="authz decision", style=dashed, color="#a855f7"];
}
